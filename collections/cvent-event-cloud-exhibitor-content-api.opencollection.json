            "method": "GET",
            "url": "https://api-platform.cvent.com/ea/events/:id/exhibitors/:exhibitorId/files",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of an event."
              },
              {
                "name": "exhibitorId",
                "value": "",
                "type": "path",
                "description": "ID of an exhibitor."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api-platform.cvent.com/ea/oauth2/token",
              "credentials": {
